[TEMPLATE]
PORT=5000

# Option A: local MongoDB install (no auth)
MONGO_URI=mongodb://localhost:27017/ai_analytics
# Option B: Docker Compose MongoDB (with auth)
# MONGO_URI=mongodb://admin:password@localhost:27017/ai_analytics?authSource=admin

JWT_SECRET=change_me_to_a_long_random_string
# Used to encrypt stored API keys. If unset, falls back to JWT_SECRET.
ENCRYPTION_KEY=change_me_to_another_long_random_string

# Admin account created by `npm run seed` (public registration is disabled).
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change_me_to_a_strong_password

# Uptime monitor polling interval in milliseconds (default 60000).
MONITOR_INTERVAL_MS=60000

# On deployment, seed the admin account + real projects/products/deployments on first boot
# (idempotent — no-ops once projects exist). Set true on a fresh deployed DB.
AUTO_SEED=true
